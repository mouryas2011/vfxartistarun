# Required host build tools (bootstrap installs these via apt when missing).
# Note: firmware (ovmf) and squashfs-tools are also required; dev-setup-ubuntu.sh
# and CI install them explicitly because they are not command-line tools.
REQUIRED_TOOLS="git make bash python3 shellcheck debootstrap xorriso qemu-system-x86_64 qemu-img mtools dosfstools"